# Configuración para el entorno de Docker (`docker compose up`).
#
# `docker/setup.sh` lo copia a `.env` la primera vez, y solo si `.env` no
# existe todavía: un `.env` propio nunca se pisa.
#
# Los datos de conexión igual llegan por variables de entorno desde
# docker-compose.yml, que en Laravel le ganan al archivo. Están acá para
# que el archivo se lea solo y para que `artisan` funcione si alguien entra
# al contenedor por fuera de compose.
#
# La contraseña de la base es `sacst` y no es un descuido: esta base vive
# en un volumen de Docker, en la máquina del desarrollador, y no se publica
# a ningún lado. Nada de acá va a producción.

APP_NAME="SAC-ST"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Argentina/Salta
APP_DISPLAY_TIMEZONE=America/Argentina/Salta

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sacst_dev
DB_USERNAME=sacst
DB_PASSWORD=sacst

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
