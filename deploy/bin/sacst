#!/bin/sh
# docker compose con el archivo de variables del servidor ya puesto.
#
#     sudo deploy/bin/sacst ps
#     sudo deploy/bin/sacst pull && sudo deploy/bin/sacst up -d
#     sudo deploy/bin/sacst exec app php artisan about
#
# Sin esto, cada comando tendría que repetir --env-file y -f, y olvidarse el
# primero hace que compose corte pidiendo SACST_VERSION.
set -eu

config_dir="${SACST_CONFIG_DIR:-/etc/sacst}"
# readlink -f: llamado por el enlace de /usr/local/bin, $0 es el enlace y
# el repo quedaría en /usr/local.
deploy_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

exec docker compose \
    --env-file "$config_dir/compose.env" \
    -f "$deploy_dir/compose.yml" \
    "$@"
