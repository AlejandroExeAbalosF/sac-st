# Entorno de Laravel en producción. Copiar a /etc/sacst/app.env (root, 600).
#
# Lo inyecta compose como variables de entorno reales: siguen valiendo con la
# configuración cacheada. Sin comillas salvo que el valor tenga espacios.
#
# El repo es público: acá van solo marcadores. Los valores reales existen
# únicamente en el servidor.

APP_NAME=SAC-ST
APP_ENV=production
APP_DEBUG=false
# Se genera una sola vez (deploy/README.md) y no se cambia nunca: cifra las
# sesiones y los secretos del doble factor.
APP_KEY=
# Fase 1, HTTP por VPN. Al habilitar el certificado: https:// (checklist del README).
APP_URL=http://sacst.dominio.gob.ar

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR
# Se guarda en UTC y se muestra en Salta. No cambiar.
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Argentina/Salta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logs ─────────────────────────────────────────────────────────────────
# El log de la aplicación va a stderr → journald. Los de seguridad y
# auditoría son archivos en storage/logs, con retención propia.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_SECURITY_DAYS=365
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_SLOW_MS=1000

# ─── PostgreSQL (en el host) ──────────────────────────────────────────────
# DB_HOST es el gateway de la red sacst_net. No usar host.docker.internal:
# resuelve a docker0, no a esta red, y PostgreSQL no escucha ahí.
DB_CONNECTION=pgsql
DB_HOST=10.200.1.1
DB_PORT=5432
DB_DATABASE=sacst
# El rol de la aplicación: lee y escribe, pero no altera tablas ni apaga
# triggers. Las migraciones usan otro (migrate.env).
DB_USERNAME=sacst_app
DB_PASSWORD=
DB_TIMEZONE=UTC

# ─── Proxies ──────────────────────────────────────────────────────────────
# De quién se aceptan los X-Forwarded-*: la red del stack (el nginx del
# contenedor web) y el proxy del data center. Sin el proxy en la lista, el
# esquema se lee igual, pero la IP que registra la auditoría es la del proxy
# y no la del usuario. Nunca '*'.
TRUSTED_PROXIES=10.200.1.0/24,IP_DEL_PROXY_DEL_DC

# ─── Sesión ───────────────────────────────────────────────────────────────
SESSION_DRIVER=database
# Minutos de inactividad: vence en el servidor, cierre o no el navegador.
SESSION_LIFETIME=120
# Cerrar el navegador cierra la sesión. Ya es el valor por defecto; va
# explícito para que se vea al leer el entorno.
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Fase 1 (HTTP): false, o el navegador descarta la cookie y no se puede
# ingresar. Con el certificado: true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ─── Colas, caché, archivos ───────────────────────────────────────────────
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Correo ───────────────────────────────────────────────────────────────
# `failover` elige solo: si MAIL_HOST tiene valor, primero el SMTP del
# organismo y Gmail de respaldo; si está vacío, Gmail directo.
MAIL_MAILER=failover
MAIL_FROM_ADDRESS=cuenta@gmail.com
MAIL_FROM_NAME=SAC-ST

# SMTP del organismo. Vacío hasta que lo asignen.
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10

# Gmail: una contraseña de aplicación, no la de la cuenta (requiere
# verificación en dos pasos). Gmail reescribe el remitente con la cuenta
# autenticada, así que MAIL_FROM_ADDRESS conviene que sea la misma.
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
