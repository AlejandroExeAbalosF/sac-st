# Variables que lee docker compose (no Laravel). Copiar a /etc/sacst/compose.env.
#
# El repo es público: los valores reales —la IP, sobre todo— se escriben solo
# en el servidor.

# Versión a correr: la etiqueta de la imagen en GHCR, sin la «v» del tag de
# git (el tag v0.1.0 publica la imagen 0.1.0). Actualizar es cambiar esto y
# hacer pull + up -d; volver atrás, lo mismo con la versión anterior.
SACST_VERSION=0.1.0

# Carpeta del servidor con todo lo que el sistema recibe o genera: adjuntos,
# logs de auditoría y de seguridad, caché. Idealmente en el disco de datos.
# Tiene que ser de 33:33 (www-data dentro del contenedor).
SACST_STORAGE_PATH=/srv/sacst/storage

# IP de la LAN y puerto donde publica nginx. El proxy del data center apunta
# acá. Nunca 0.0.0.0.
SACST_WEB_BIND=IP_DEL_SERVIDOR:8080

# IP (o red CIDR) del proxy del data center. Es el único origen al que
# nginx le cree X-Forwarded-Proto; a cualquier otro le aplica el esquema
# real. Tiene que figurar también en TRUSTED_PROXIES de app.env.
SACST_DC_PROXY_IP=IP_DEL_PROXY_DEL_DC

# Solo si los archivos de entorno no viven en /etc/sacst.
# SACST_CONFIG_DIR=/etc/sacst
